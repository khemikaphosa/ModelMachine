<script>

/* =====================================================
   STATE
===================================================== */

let step = 1;
let K = 3;


/* =====================================================
   ELEMENTS
===================================================== */

const nextBtn =
    document.getElementById("nextBtn");

const resetBtn =
    document.getElementById("resetBtn");

const slider =
    document.getElementById("kSlider");

const kNumber =
    document.getElementById("kNumber");

const panelStep =
    document.getElementById("panelStep");

const panelTitle =
    document.getElementById("panelTitle");

const panelDescription =
    document.getElementById("panelDescription");

const tie =
    document.getElementById("tie");

const radius =
    document.getElementById("radius");


const lines = {

    A:document.getElementById("lineA"),
    B:document.getElementById("lineB"),
    C:document.getElementById("lineC"),
    D:document.getElementById("lineD")

};


const labels = {

    A:document.getElementById("distA"),
    B:document.getElementById("distB"),
    C:document.getElementById("distC"),
    D:document.getElementById("distD")

};


const rows = {

    A:document.getElementById("rowA"),
    B:document.getElementById("rowB"),
    C:document.getElementById("rowC"),
    D:document.getElementById("rowD")

};



/* =====================================================
   K SLIDER
===================================================== */

slider.addEventListener("input",()=>{

    K = Number(slider.value);

    kNumber.textContent = K;

    if(step === 3){

        updateStep();

    }

});



/* =====================================================
   RESET VISUAL
===================================================== */

function clearVisual(){

    Object.values(lines).forEach(el=>{

        el.classList.remove("show");
        el.classList.remove("selected");

    });


    Object.values(labels).forEach(el=>{

        el.classList.remove("show");

    });


    Object.values(rows).forEach(el=>{

        el.classList.remove("active");

    });


    radius.classList.remove("show");

    radius.setAttribute("r","0");

    tie.classList.remove("show");

}



/* =====================================================
   STEP UPDATE
===================================================== */

function updateStep(){

    clearVisual();


    panelStep.textContent =
        `STEP ${String(step).padStart(2,"0")}`;



    /* -----------------------------------------------
       STEP 1
    ----------------------------------------------- */

    if(step === 1){

        panelTitle.innerHTML =
            "Start<br>with data.";

        panelDescription.innerHTML =
            "Q คือข้อมูลใหม่ " +
            "ที่เรายังไม่รู้ว่าเป็นกลุ่มไหน " +
            "ส่วน A–D คือข้อมูลที่มี class อยู่แล้ว";

        nextBtn.textContent =
            "MEASURE DISTANCE →";

    }



    /* -----------------------------------------------
       STEP 2
    ----------------------------------------------- */

    if(step === 2){

        panelTitle.innerHTML =
            "Measure<br>distance.";

        panelDescription.innerHTML =
            "เราวัดระยะจาก Q " +
            "ไปยังทุกจุด " +
            "เพื่อดูว่าใครอยู่ใกล้ที่สุด";

        nextBtn.textContent =
            "FIND NEIGHBORS →";


        ["A","B","C","D"].forEach((key,index)=>{

            setTimeout(()=>{

                lines[key].classList.add("show");

                labels[key].classList.add("show");

                rows[key].classList.add("active");

            },index*180);

        });

    }



    /* -----------------------------------------------
       STEP 3
    ----------------------------------------------- */

    if(step === 3){

        panelTitle.innerHTML =
            "Choose<br>K = " + K + ".";

        panelDescription.innerHTML =
            "เลือกเพื่อนบ้านที่ใกล้ที่สุด " +
            K + " จุด";

        nextBtn.textContent =
            "COUNT THE VOTES →";


        Object.values(lines).forEach(el=>{
            el.classList.add("show");
        });

        Object.values(labels).forEach(el=>{
            el.classList.add("show");
        });


        rows.A.classList.add("active");
        rows.B.classList.add("active");


        if(K >= 3){

            rows.C.classList.add("active");

            lines.C.classList.add("selected");

        }


        if(K >= 4){

            rows.D.classList.add("active");

            lines.D.classList.add("selected");

        }


        if(K === 3){

            radius.setAttribute("r","255");

            radius.classList.add("show");

            tie.classList.add("show");

        }

    }



    /* -----------------------------------------------
       STEP 4
    ----------------------------------------------- */

    if(step === 4){

        panelTitle.innerHTML =
            "Count<br>the votes.";

        panelDescription.innerHTML =
            "A และ B เป็น NORMAL " +
            "จึงได้ 2 เสียง " +
            "ส่วน C หรือ D ได้ 1 เสียง";

        nextBtn.textContent =
            "REVEAL RESULT →";


        rows.A.classList.add("active");
        rows.B.classList.add("active");

        if(K >= 3){
            rows.C.classList.add("active");
        }

        if(K >= 4){
            rows.D.classList.add("active");
        }

    }



    /* -----------------------------------------------
       STEP 5
    ----------------------------------------------- */

    if(step === 5){

        panelTitle.innerHTML =
            "Decision<br>made.";

        panelDescription.innerHTML =
            "เสียงส่วนใหญ่เป็น NORMAL " +
            "ดังนั้น Q = (2,2) " +
            "จึงถูกจัดเป็น NORMAL";

        nextBtn.textContent =
            "RESTART ↻";

    }

}



/* =====================================================
   NEXT
===================================================== */

nextBtn.addEventListener("click",()=>{

    if(step < 5){

        step++;

    }else{

        step = 1;

    }

    updateStep();

});



/* =====================================================
   RESET
===================================================== */

resetBtn.addEventListener("click",()=>{

    step = 1;

    K = 3;

    slider.value = 3;

    kNumber.textContent = 3;

    updateStep();

});



/* =====================================================
   SPACE
===================================================== */

document.addEventListener("keydown",(e)=>{

    if(e.code === "Space"){

        e.preventDefault();

        nextBtn.click();

    }

});



/* =====================================================
   INIT
===================================================== */

updateStep();

</script>

</body>
</html>
